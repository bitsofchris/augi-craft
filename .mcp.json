{
  "mcpServers": {
    "augi-craft": {
      "command": "node",
      "args": ["runtime/mcp/server.js"],
      "env": {
        "MC_HOST": "${MC_HOST:-127.0.0.1}",
        "MC_PORT": "${MC_PORT:-25565}",
        "MC_USERNAME": "${MC_USERNAME:-Augi}",
        "MC_AUTH": "${MC_AUTH:-offline}",
        "MC_VERSION": "${MC_VERSION:-26.3}"
      }
    }
  }
}
